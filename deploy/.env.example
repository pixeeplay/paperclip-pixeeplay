# Variables à saisir dans Coolify (Environment Variables du service Paperclip)
# Les SERVICE_* du docker-compose sont générées automatiquement par Coolify.

# --- Moteur IA des agents -----------------------------------------------------
# Abonnement Claude Max : sur ton Mac (déjà connecté), lance `claude setup-token`
# et colle ici le token affiché (commence par sk-ant-oat01-...).
CLAUDE_CODE_OAUTH_TOKEN=

# Ou, à la place, une clé API Anthropic (facturation à l'usage).
ANTHROPIC_API_KEY=

# Optionnel : adapter codex_local (OpenAI)
OPENAI_API_KEY=

# --- GitHub ------------------------------------------------------------------
# PAT fine-grained (repo: contents+pull_requests+workflows) sur pixeeplay/* et
# cirquephotovideo/* — permet aux agents de cloner, pousser, ouvrir des PR.
GH_TOKEN=
GIT_AUTHOR_NAME=Pixeeplay Agents
GIT_AUTHOR_EMAIL=agents@pixeeplay.com

# --- Sécurité ------------------------------------------------------------------
# Mettre à true après création du compte admin (bloque toute nouvelle inscription)
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false

# --- Hors Coolify uniquement (install-vps.sh) ---------------------------------
# PAPERCLIP_PUBLIC_URL=https://paperclip.pixeeplay.com
# POSTGRES_PASSWORD=
# BETTER_AUTH_SECRET=
# PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# --- Accès Coolify pour l'agent DevOps & Release (optionnel) ---
COOLIFY_URL=http://51.75.31.123:8000
COOLIFY_API_TOKEN=
COOLIFY_SERVER_UUID=
COOLIFY_PROJECT_UUID=

# --- CRM Attio (optionnel) : clé API workspace, lecture/écriture notes, réunions, enregistrements ---
ATTIO_API_KEY=

# --- Pixeeplay Co. (agents Buzz) ---
RESEND_API_KEY=
ZERNIO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
